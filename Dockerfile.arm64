# syntax=docker/dockerfile:1
# arm64 variant: the linux-arm64 release asset ships no ONNX Runtime
# (upstream build.rs: no arm64 ONNX prebuilt), so OCR self-disables at
# runtime; fetch/search/crawl/PDF/screenshot all remain available.
# The tarball contains only the `donsetch` binary.

FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 \
    && apt-get clean

COPY donsetch /usr/local/bin/donsetch
RUN chmod 0755 /usr/local/bin/donsetch

RUN useradd -m -u 1000 donsetch \
    && mkdir -p /home/donsetch/.cache/donsetch \
    && chown -R donsetch:donsetch /home/donsetch/.cache
USER donsetch
WORKDIR /home/donsetch

VOLUME /home/donsetch/.cache/donsetch

RUN donsetch --version

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD donsetch --version || exit 1

ENV DONSETCH_HTTP_HOST=0.0.0.0 \
    DONSETCH_TRANSPORT=http
EXPOSE 8765

STOPSIGNAL SIGTERM
CMD ["donsetch", "mcp", "--http", "--port", "8765"]
